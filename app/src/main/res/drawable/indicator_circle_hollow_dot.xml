<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3.4dp"
                android:color="@color/lesson_type_default" />
            <solid android:color="@android:color/transparent" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>

    <item
        android:left="9dp"
        android:right="9dp"
        android:top="9dp"
        android:bottom="9dp">
        <shape android:shape="oval">
            <solid android:color="@color/lesson_type_default" />
        </shape>
    </item>

</layer-list>
