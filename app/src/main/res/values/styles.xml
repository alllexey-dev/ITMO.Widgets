<resources>

    <style name="Base.AppTheme" parent="Theme.Material3.DynamicColors.DayNight">
<!--        <item name="colorPrimary">@color/primary_color</item>-->
        <item name="android:statusBarColor">?android:colorBackground</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <style name="FilledButton" parent="Widget.Material3.Button">
    </style>

    <style name="AlertDialogTheme_FilledButton" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/FilledButton</item>
    </style>

    <style name="SportTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Widget.ItmoWidgets.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">64dp</item>
        <item name="itemPaddingTop">@dimen/design_spacing_related</item>
        <item name="itemPaddingBottom">@dimen/design_spacing_related</item>
    </style>

    <!-- Grouped settings/profile rows: one quiet card per group, never per row. -->

    <style name="Widget.ItmoWidgets.SettingsGroupLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/design_spacing_section</item>
        <item name="android:layout_marginBottom">@dimen/design_spacing_compact</item>
        <!-- Lines up with the row titles inside the card. -->
        <item name="android:layout_marginStart">@dimen/design_spacing_group</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.ItmoWidgets.SettingsCard" parent="Widget.ItmoWidgets.Card.SettingsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.ItmoWidgets.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/design_spacing_group</item>
        <item name="android:paddingVertical">@dimen/design_spacing_content</item>
    </style>

    <style name="Widget.ItmoWidgets.SettingsRowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">@dimen/design_spacing_group</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.ItmoWidgets.SettingsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">@dimen/design_spacing_group</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <!-- Compact settings are scoped separately from the existing profile rows. -->

    <style name="Widget.ItmoWidgets.CompactSettingsGroupLabel" parent="Widget.ItmoWidgets.SettingsGroupLabel">
        <item name="android:layout_marginTop">@dimen/design_spacing_group</item>
        <item name="android:layout_marginEnd">@dimen/design_spacing_group</item>
    </style>

    <style name="Widget.ItmoWidgets.CompactSettingsCard" parent="Widget.ItmoWidgets.Card.SettingsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.ItmoWidgets.CompactSettingsRow" parent="Widget.ItmoWidgets.SettingsRow">
        <item name="android:minHeight">@dimen/design_touch_target</item>
        <item name="android:paddingVertical">@dimen/design_spacing_compact</item>
    </style>

    <style name="Widget.ItmoWidgets.CompactSettingsRowText" parent="Widget.ItmoWidgets.SettingsRowText">
        <item name="android:layout_marginEnd">@dimen/design_spacing_content</item>
    </style>

    <style name="Widget.ItmoWidgets.CompactSettingsDivider" parent="Widget.ItmoWidgets.SettingsDivider">
        <item name="android:layout_marginEnd">@dimen/design_spacing_group</item>
        <item name="android:alpha">0.5</item>
    </style>

    <style name="Widget.ItmoWidgets.CompactSettingsSectionFooter" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">@dimen/design_spacing_group</item>
        <item name="android:layout_marginTop">@dimen/design_spacing_compact</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>
