<resources>

    <!-- Surface and shape are shared; content padding and list spacing belong to each role. -->
    <style name="Widget.ItmoWidgets.Card.Content" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">@dimen/design_card_radius_content</item>
        <item name="cardElevation">@dimen/design_card_elevation</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.ItmoWidgets.Card.Content.Outlined" parent="Widget.ItmoWidgets.Card.Content">
        <item name="strokeWidth">@dimen/design_card_stroke</item>
    </style>

    <!-- The compact recordbook summary keeps its slightly stronger neutral surface and 20 dp shape. -->
    <style name="Widget.ItmoWidgets.Card.CompactSummary" parent="Widget.ItmoWidgets.Card.Content">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>

    <style name="Widget.ItmoWidgets.Card.Summary" parent="Widget.ItmoWidgets.Card.Content">
        <item name="cardCornerRadius">@dimen/design_card_radius_summary</item>
    </style>

    <style name="Widget.ItmoWidgets.Card.ScheduleDay" parent="Widget.ItmoWidgets.Card.Content">
        <item name="cardCornerRadius">@dimen/design_card_radius_day</item>
    </style>

    <style name="Widget.ItmoWidgets.Card.SettingsGroup" parent="Widget.ItmoWidgets.Card.Content">
        <item name="cardUseCompatPadding">false</item>
        <item name="cardPreventCornerOverlap">false</item>
    </style>

    <style name="Widget.ItmoWidgets.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:minHeight">64dp</item>
        <item name="itemPaddingTop">@dimen/design_spacing_related</item>
        <item name="itemPaddingBottom">@dimen/design_spacing_related</item>
    </style>

    <!-- Grouped settings/profile rows: one quiet card per group, never per row. -->

    <style name="Widget.ItmoWidgets.SettingsGroupLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/design_spacing_section</item>
        <item name="android:layout_marginBottom">@dimen/design_spacing_compact</item>
        <!-- Lines up with the row titles inside the card. -->
        <item name="android:layout_marginStart">@dimen/design_spacing_group</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.ItmoWidgets.SettingsCard" parent="Widget.ItmoWidgets.Card.SettingsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.ItmoWidgets.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/design_spacing_group</item>
        <item name="android:paddingVertical">@dimen/design_spacing_content</item>
    </style>

    <style name="Widget.ItmoWidgets.SettingsRowText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">@dimen/design_spacing_group</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.ItmoWidgets.SettingsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">@dimen/design_spacing_group</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <!-- Compact settings are scoped separately from the existing profile rows. -->

    <style name="Widget.ItmoWidgets.CompactSettingsGroupLabel" parent="Widget.ItmoWidgets.SettingsGroupLabel">
        <item name="android:layout_marginTop">@dimen/design_spacing_group</item>
        <item name="android:layout_marginEnd">@dimen/design_spacing_group</item>
    </style>

    <style name="Widget.ItmoWidgets.CompactSettingsCard" parent="Widget.ItmoWidgets.Card.SettingsGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="Widget.ItmoWidgets.CompactSettingsRow" parent="Widget.ItmoWidgets.SettingsRow">
        <item name="android:minHeight">@dimen/design_touch_target</item>
        <item name="android:paddingVertical">@dimen/design_spacing_compact</item>
    </style>

    <style name="Widget.ItmoWidgets.CompactSettingsRowText" parent="Widget.ItmoWidgets.SettingsRowText">
        <item name="android:layout_marginEnd">@dimen/design_spacing_content</item>
    </style>

    <style name="Widget.ItmoWidgets.CompactSettingsDivider" parent="Widget.ItmoWidgets.SettingsDivider">
        <item name="android:layout_marginEnd">@dimen/design_spacing_group</item>
        <item name="android:alpha">0.5</item>
    </style>

    <style name="Widget.ItmoWidgets.CompactSettingsSectionFooter" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">@dimen/design_spacing_group</item>
        <item name="android:layout_marginTop">@dimen/design_spacing_compact</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Empty, error and loading blocks share one vertical rhythm across every screen. -->

    <style name="Widget.ItmoWidgets.ContentState" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">@dimen/design_state_padding</item>
    </style>

    <style name="Widget.ItmoWidgets.ContentState.Icon" parent="">
        <item name="android:layout_width">@dimen/design_state_icon</item>
        <item name="android:layout_height">@dimen/design_state_icon</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">?attr/colorPrimary</item>
    </style>

    <style name="Widget.ItmoWidgets.ContentState.InlineIcon" parent="Widget.ItmoWidgets.ContentState.Icon">
        <item name="android:layout_width">@dimen/design_state_inline_icon</item>
        <item name="android:layout_height">@dimen/design_state_inline_icon</item>
    </style>

    <style name="Widget.ItmoWidgets.ContentState.Title" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/design_spacing_group</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.ItmoWidgets.ContentState.Description" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/design_spacing_compact</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Compact outbound link at the foot of the profile: logo plus label, 48 dp touch height kept by insets. -->
    <style name="Widget.ItmoWidgets.ProjectLink" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.ItmoWidgets.ContentState.Action" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:minHeight">@dimen/design_touch_target</item>
    </style>

    <style name="Widget.ItmoWidgets.ContentState.PrimaryAction" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:minHeight">@dimen/design_touch_target</item>
    </style>

    <style name="TextAppearance.ItmoWidgets.SportTab" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="textAllCaps">false</item>
    </style>

</resources>
