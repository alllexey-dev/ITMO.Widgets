<resources>
    <declare-styleable name="AppWidgetAttrs">
        <attr name="appWidgetPadding" format="dimension" />
        <attr name="appWidgetInnerRadius" format="dimension" />
        <attr name="appWidgetRadius" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CircularProgressBar">
        <attr name="progressBarThickness" format="dimension" />
        <attr name="bgColor" format="color" />
        <attr name="sectorGapAngle" format="float" />
    </declare-styleable>

    <declare-styleable name="SkeletonView">
        <attr name="skeletonRows" format="integer" />
        <attr name="skeletonRowHeight" format="dimension" />
        <attr name="skeletonStyle" format="enum">
            <enum name="list" value="0" />
            <enum name="card" value="1" />
        </attr>
    </declare-styleable>

</resources>
