<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Surface and shape are shared; content padding and list spacing belong to each role. -->
    <style name="Widget.ItmoWidgets.Card.Content" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">@dimen/design_card_radius_content</item>
        <item name="cardElevation">@dimen/design_card_elevation</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.ItmoWidgets.Card.Content.Outlined" parent="Widget.ItmoWidgets.Card.Content">
        <item name="strokeWidth">@dimen/design_card_stroke</item>
    </style>

    <!-- The compact recordbook summary keeps its slightly stronger neutral surface and 20 dp shape. -->
    <style name="Widget.ItmoWidgets.Card.CompactSummary" parent="Widget.ItmoWidgets.Card.Content">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>

    <style name="Widget.ItmoWidgets.Card.Summary" parent="Widget.ItmoWidgets.Card.Content">
        <item name="cardCornerRadius">@dimen/design_card_radius_summary</item>
    </style>

    <style name="Widget.ItmoWidgets.Card.ScheduleDay" parent="Widget.ItmoWidgets.Card.Content">
        <item name="cardCornerRadius">@dimen/design_card_radius_day</item>
    </style>

    <style name="Widget.ItmoWidgets.Card.SettingsGroup" parent="Widget.ItmoWidgets.Card.Content">
        <item name="cardUseCompatPadding">false</item>
        <item name="cardPreventCornerOverlap">false</item>
    </style>

</resources>
