<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: follow the launcher's widget corner radius. The widget root carries @android:id/background
     and clipToOutline, so the launcher can match its own radius and animations to this shape. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/widget_surface" />

    <stroke
        android:width="1dp"
        android:color="@color/widget_outline_variant" />

    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
