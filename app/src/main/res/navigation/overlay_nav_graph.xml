<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlay_nav_graph"
    app:startDestination="@id/settings">

    <fragment
        android:id="@+id/settings"
        android:name="dev.alllexey.itmowidgets.feature.settings.ui.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <argument
            android:name="settings_page"
            android:defaultValue="ROOT"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/diagnostics"
        android:name="dev.alllexey.itmowidgets.feature.settings.ui.DiagnosticsFragment"
        android:label="diagnostics" />

    <fragment
        android:id="@+id/debug_tools"
        android:name="dev.alllexey.itmowidgets.feature.debug.ui.DebugToolsFragment"
        android:label="Debug tools"
        tools:layout="@layout/fragment_debug_tools" />

    <fragment
        android:id="@+id/app_update"
        android:name="dev.alllexey.itmowidgets.feature.update.ui.AppUpdateFragment"
        android:label="App update"
        tools:layout="@layout/fragment_app_update" />

    <fragment
        android:id="@+id/recordbook_subject"
        android:name="dev.alllexey.itmowidgets.feature.recordbook.ui.RecordbookSubjectFragment"
        android:label="Record book subject"
        tools:layout="@layout/fragment_recordbook_subject" />

    <fragment
        android:id="@+id/friends"
        android:name="dev.alllexey.itmowidgets.feature.social.ui.FriendsFragment"
        android:label="Friends"
        tools:layout="@layout/fragment_friends" />

    <fragment
        android:id="@+id/user_friends"
        android:name="dev.alllexey.itmowidgets.feature.social.ui.UserFriendsFragment"
        android:label="Друзья"
        tools:layout="@layout/fragment_user_friends">
        <argument android:name="user_isu" app:argType="integer" />
        <argument android:name="user_name" android:defaultValue="" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/user_search"
        android:name="dev.alllexey.itmowidgets.feature.social.ui.UserSearchFragment"
        android:label="Find people"
        tools:layout="@layout/fragment_user_search" />

    <fragment
        android:id="@+id/user_profile"
        android:name="dev.alllexey.itmowidgets.feature.social.ui.UserProfileFragment"
        android:label="User profile"
        tools:layout="@layout/fragment_user_profile">
        <argument
            android:name="user_isu"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/user_schedule"
        android:name="dev.alllexey.itmowidgets.feature.schedule.ui.UserScheduleFragment"
        android:label="User schedule"
        tools:layout="@layout/fragment_user_schedule">
        <argument
            android:name="user_isu"
            app:argType="integer" />
        <argument
            android:name="user_name"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/user_sport"
        android:name="dev.alllexey.itmowidgets.feature.sport.ui.user.UserSportFragment"
        android:label="User sport"
        tools:layout="@layout/fragment_user_sport">
        <argument
            android:name="user_isu"
            app:argType="integer" />
        <argument
            android:name="user_name"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/qr_pass"
        android:name="dev.alllexey.itmowidgets.feature.qr.ui.QrCodeFragment"
        android:label="@string/title_qr"
        tools:layout="@layout/fragment_qr_code" />

    <fragment
        android:id="@+id/my_itmo_web"
        android:name="dev.alllexey.itmowidgets.feature.web.ui.MyItmoWebFragment"
        android:label="@string/my_itmo_web_title"
        tools:layout="@layout/fragment_my_itmo_web" />

</navigation>
