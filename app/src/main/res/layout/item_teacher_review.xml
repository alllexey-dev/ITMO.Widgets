<?xml version="1.0" encoding="utf-8"?>
<!--
    A review as a row of the reviews group: who wrote it (a named author or a Reviews source, both links; «Анонимный отзыв»
    otherwise) with ⋮, one meta line, the full text, then the verification mark and the vote pill.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/design_card_padding"
    android:paddingTop="@dimen/design_spacing_related"
    android:paddingEnd="@dimen/design_spacing_related"
    android:paddingBottom="@dimen/design_spacing_related">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/design_touch_target"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/design_spacing_compact"
            android:layout_weight="1">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/author"
                style="@style/Widget.ItmoWidgets.ReviewOriginButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:visibility="gone"
                tools:text="Иванова А. С."
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/source"
                style="@style/Widget.ItmoWidgets.ReviewOriginButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                app:icon="@drawable/ic_open_in_new"
                app:iconGravity="textEnd"
                app:iconPadding="@dimen/design_spacing_related"
                app:iconSize="16dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                tools:text="Reviews" />

            <TextView
                android:id="@+id/anonymous"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/teacher_review_anonymous"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </FrameLayout>

        <ImageButton
            android:id="@+id/more"
            android:layout_width="@dimen/design_touch_target"
            android:layout_height="@dimen/design_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/teacher_review_actions"
            android:padding="@dimen/design_spacing_content"
            android:src="@drawable/ic_more_vert_rounded"
            android:visibility="invisible"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />

    </LinearLayout>

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/design_spacing_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="Математический анализ, сентябрь 2024"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/design_spacing_related"
        android:layout_marginEnd="@dimen/design_spacing_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="Понятно объясняет материал и подробно отвечает на вопросы." />

    <dev.alllexey.itmowidgets.feature.social.ui.ReviewFooterLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/design_spacing_related"
        android:minHeight="@dimen/design_touch_target">

        <LinearLayout
            android:id="@+id/origin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/verified"
                layout="@layout/view_review_verified" />

            <TextView
                android:id="@+id/unverified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/teacher_review_unverified"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

        <include
            android:id="@+id/votes"
            layout="@layout/view_link_vote_pill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/design_touch_target" />

    </dev.alllexey.itmowidgets.feature.social.ui.ReviewFooterLayout>

</LinearLayout>
