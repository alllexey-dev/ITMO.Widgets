<?xml version="1.0" encoding="utf-8"?>
<!-- Author (named reviews only), one meta line, the full text, a 48 dp row with the mark or source on the left and votes on the right. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.ItmoWidgets.Card.Content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/design_card_padding"
        android:paddingTop="@dimen/design_card_padding"
        android:paddingEnd="@dimen/design_spacing_related"
        android:paddingBottom="@dimen/design_spacing_related">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/author"
            style="@style/Widget.ItmoWidgets.ReviewOriginButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-12dp"
            android:layout_marginBottom="-6dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:visibility="gone"
            tools:text="Иванова А. С."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/design_spacing_content"
            android:layout_marginBottom="@dimen/design_spacing_related"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Математический анализ · Сентябрь 2024"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/design_spacing_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Понятно объясняет материал и подробно отвечает на вопросы." />

        <dev.alllexey.itmowidgets.feature.social.ui.ReviewFooterLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/design_spacing_related"
            android:minHeight="@dimen/design_touch_target">

            <LinearLayout
                android:id="@+id/origin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/design_spacing_related">

                <include
                    android:id="@+id/verified"
                    layout="@layout/view_review_verified" />

                <TextView
                    android:id="@+id/unverified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/teacher_review_unverified"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/source"
                    style="@style/Widget.ItmoWidgets.ReviewOriginButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    app:icon="@drawable/ic_open_in_new"
                    app:iconGravity="textEnd"
                    app:iconPadding="@dimen/design_spacing_related"
                    app:iconSize="16dp"
                    app:iconTint="?attr/colorOnSurfaceVariant"
                    tools:text="Reviews · ИТМО" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/votes"
                    layout="@layout/view_review_votes" />

                <ImageButton
                    android:id="@+id/more"
                    android:layout_width="@dimen/design_touch_target"
                    android:layout_height="@dimen/design_touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/teacher_review_actions"
                    android:padding="@dimen/design_spacing_content"
                    android:src="@drawable/ic_more_vert_rounded"
                    android:visibility="invisible"
                    app:tint="?attr/colorOnSurfaceVariant"
                    tools:visibility="visible" />

            </LinearLayout>

        </dev.alllexey.itmowidgets.feature.social.ui.ReviewFooterLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
