<?xml version="1.0" encoding="utf-8"?>
<!--
    A review as a row of the reviews group: the caption (subject, date) with ⋮, the full text, then the footer: who
    wrote it (a named author or the source, both links; «Анонимный отзыв» otherwise), its verification and the votes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/design_card_padding"
    android:paddingTop="@dimen/design_spacing_related"
    android:paddingEnd="@dimen/design_spacing_related"
    android:paddingBottom="@dimen/design_spacing_related">

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/design_touch_target"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/design_spacing_compact"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Математический анализ, сентябрь 2024" />

        <ImageButton
            android:id="@+id/more"
            android:layout_width="@dimen/design_touch_target"
            android:layout_height="@dimen/design_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/teacher_review_actions"
            android:padding="@dimen/design_spacing_content"
            android:src="@drawable/ic_more_vert_rounded"
            android:visibility="invisible"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />

    </LinearLayout>

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/design_spacing_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="Понятно объясняет материал и подробно отвечает на вопросы." />

    <!-- Who wrote it with its verification under it on the left, the votes centred on that column on the right. -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_marginTop="@dimen/design_spacing_compact"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/credit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/design_spacing_compact"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Links keep a 48 dp target; the line below tucks into its padding. -->
            <FrameLayout
                android:id="@+id/origin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-12dp"
                android:layout_marginBottom="-12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/author"
                    style="@style/Widget.ItmoWidgets.ReviewOriginButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:visibility="gone"
                    tools:text="Иванова А. С."
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/source"
                    style="@style/Widget.ItmoWidgets.ReviewOriginButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    app:icon="@drawable/ic_open_in_new"
                    app:iconGravity="textEnd"
                    app:iconPadding="@dimen/design_spacing_related"
                    app:iconSize="16dp"
                    app:iconTint="?attr/colorOnSurfaceVariant"
                    tools:text="Reviews" />

                <TextView
                    android:id="@+id/anonymous"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/design_touch_target"
                    android:text="@string/teacher_review_anonymous"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- An ImageView, not a compound drawable: the check is 16 dp, which a compound drawable cannot be in XML. -->
            <LinearLayout
                android:id="@+id/verified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="UseCompoundDrawables"
                android:layout_marginTop="@dimen/design_spacing_related"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="@dimen/design_spacing_related"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/verified_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/teacher_review_verified"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

            <TextView
                android:id="@+id/unverified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/design_spacing_related"
                android:text="@string/teacher_review_unverified"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

        <include
            android:id="@+id/votes"
            layout="@layout/view_link_vote_pill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/design_touch_target" />

    </LinearLayout>

</LinearLayout>
