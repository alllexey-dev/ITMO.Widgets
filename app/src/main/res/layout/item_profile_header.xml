<?xml version="1.0" encoding="utf-8"?>
<!--
    The person in a result card: avatar, name, one short line, the ISU number with a copy symbol, and the friendship:
    a badge for a friend or the viewer, otherwise a status line and the request buttons.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.ItmoWidgets.Card.Hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/design_spacing_compact">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/design_summary_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <dev.alllexey.itmowidgets.core.ui.AvatarView
                android:id="@+id/avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="noHideDescendants" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/design_spacing_group"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:breakStrategy="high_quality"
                    android:hyphenationFrequency="normal"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    tools:targetApi="p"
                    tools:text="Иванов Иван Иванович" />

                <TextView
                    android:id="@+id/headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="Преподаватель"
                    tools:visibility="visible" />

                <!-- 48 dp target drawn into the gaps around the line, so the card keeps its compact rhythm. -->
                <LinearLayout
                    android:id="@+id/isu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-12dp"
                    android:layout_marginBottom="-12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/design_touch_target"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:paddingEnd="@dimen/design_spacing_content">

                    <TextView
                        android:id="@+id/isu_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:importantForAccessibility="no"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="100001" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_content_copy"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <TextView
                    android:id="@+id/badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/design_spacing_compact"
                    android:background="@drawable/bg_link_own_badge"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/design_spacing_compact"
                    android:paddingVertical="2dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:visibility="gone"
                    tools:text="в друзьях"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/relationship_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/design_spacing_group"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Хочет добавить вас"
            tools:visibility="visible" />

        <!-- Side by side; stacked when «Принять заявку» and «Отклонить» do not fit in one row. -->
        <dev.alllexey.itmowidgets.core.ui.ButtonRow
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/design_spacing_group"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primary_action"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/design_touch_target"
                tools:text="Добавить в друзья" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/secondary_action"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/design_spacing_compact"
                android:minHeight="@dimen/design_touch_target"
                android:visibility="gone"
                tools:text="Отклонить"
                tools:visibility="visible" />

        </dev.alllexey.itmowidgets.core.ui.ButtonRow>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
