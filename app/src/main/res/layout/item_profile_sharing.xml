<?xml version="1.0" encoding="utf-8"?>
<!-- «ITMO.Widgets»: friends, schedule and sport as one connected group, the privacy hint, removing a friend. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/heading"
        layout="@layout/item_section_heading" />

    <include
        android:id="@+id/friends_row"
        layout="@layout/item_profile_entry" />

    <include
        android:id="@+id/schedule_row"
        layout="@layout/item_profile_entry" />

    <include
        android:id="@+id/sport_row"
        layout="@layout/item_profile_entry" />

    <TextView
        android:id="@+id/hidden_hint"
        style="@style/Widget.ItmoWidgets.CompactSettingsSectionFooter"
        android:text="@string/user_profile_hidden_friends_hint"
        android:visibility="gone"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/remove_friend"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/design_spacing_related"
        android:layout_marginTop="@dimen/design_spacing_compact"
        android:minHeight="@dimen/design_touch_target"
        android:text="@string/user_profile_remove_friend"
        android:textColor="?attr/colorError"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
