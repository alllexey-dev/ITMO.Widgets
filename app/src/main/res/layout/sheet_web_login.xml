<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/design_spacing_group">

        <View style="@style/Widget.ItmoWidgets.SheetHandle" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/design_screen_margin"
            android:layout_marginTop="@dimen/design_spacing_group"
            android:accessibilityHeading="true"
            android:text="@string/web_login_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            tools:targetApi="p" />

        <!-- Code: the scanner first, the field for a code typed from the screen. -->
        <LinearLayout
            android:id="@+id/input_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_button"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/design_screen_margin"
                android:layout_marginTop="@dimen/design_spacing_group"
                android:minHeight="@dimen/design_touch_target"
                android:text="@string/web_login_scan"
                app:icon="@drawable/ic_qr_code_scanner" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/code_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/design_screen_margin"
                android:layout_marginTop="@dimen/design_spacing_group"
                android:hint="@string/web_login_code_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continue_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/design_screen_margin"
                android:layout_marginTop="@dimen/design_spacing_compact"
                android:minHeight="@dimen/design_touch_target"
                android:text="@string/web_login_continue"
                app:iconGravity="textStart" />

        </LinearLayout>

        <!-- The browser that asked, then «Войти». -->
        <LinearLayout
            android:id="@+id/confirm_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- A nested panel: the sheet itself already sits on colorSurfaceContainerLow. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/browser_card"
                style="@style/Widget.ItmoWidgets.Card.Content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/design_screen_margin"
                android:layout_marginTop="@dimen/design_spacing_group">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/design_card_padding">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/design_spacing_group"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_computer"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/browser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="Chrome на macOS" />

                        <TextView
                            android:id="@+id/requested_at"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/design_spacing_related"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Запрошен в 12:04" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/own_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/design_screen_margin"
                android:layout_marginTop="@dimen/design_spacing_compact"
                android:text="@string/web_login_own_only"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/approve_button"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/design_screen_margin"
                android:layout_marginTop="@dimen/design_spacing_group"
                android:minHeight="@dimen/design_touch_target"
                android:text="@string/web_login_approve"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/design_screen_margin"
                android:layout_marginTop="@dimen/design_spacing_related"
                android:minHeight="@dimen/design_touch_target"
                android:text="@string/common_cancel" />

        </LinearLayout>

        <!-- Done and error share the compact content-state geometry. -->
        <LinearLayout
            android:id="@+id/result_group"
            style="@style/Widget.ItmoWidgets.ContentState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/design_screen_margin"
            android:paddingTop="@dimen/design_spacing_section"
            android:paddingBottom="@dimen/design_spacing_compact"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/result_icon"
                style="@style/Widget.ItmoWidgets.ContentState.InlineIcon"
                android:contentDescription="@null"
                tools:src="@drawable/ic_check_circle" />

            <TextView
                android:id="@+id/result_text"
                style="@style/Widget.ItmoWidgets.ContentState.Title"
                android:accessibilityLiveRegion="polite"
                tools:text="@string/web_login_done" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/result_button"
                style="@style/Widget.ItmoWidgets.ContentState.Action"
                tools:text="@string/common_close" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
