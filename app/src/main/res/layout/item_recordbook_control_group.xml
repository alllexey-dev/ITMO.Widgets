<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/design_touch_target"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="@dimen/design_spacing_compact"
    android:paddingEnd="@dimen/design_card_padding"
    android:paddingBottom="@dimen/design_spacing_related">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Лабораторные" />

        <TextView android:id="@+id/below_minimum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/design_spacing_related"
            android:background="@drawable/bg_grade_badge"
            android:importantForAccessibility="no"
            android:paddingHorizontal="@dimen/design_spacing_compact"
            android:paddingVertical="2dp"
            android:text="@string/recordbook_group_below_minimum"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/design_spacing_compact"
        android:fontFeatureSettings="tnum"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="30 / 48" />
</LinearLayout>
