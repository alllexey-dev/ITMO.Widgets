<?xml version="1.0" encoding="utf-8"?>
<!-- A link in a connected group: optional category icon, title, caption, and «моя» or the vote pill at the end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:longClickable="true"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/design_card_padding"
    android:paddingTop="@dimen/design_spacing_compact"
    android:paddingEnd="@dimen/design_spacing_related"
    android:paddingBottom="@dimen/design_spacing_compact">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/design_card_padding"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant"
        tools:src="@drawable/ic_table"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/design_spacing_compact"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="@dimen/design_spacing_related">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="high_quality"
            android:hyphenationFrequency="normal"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="Баллы потока" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="docs.google.com, P3119" />

    </LinearLayout>

    <TextView
        android:id="@+id/own_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/design_spacing_content"
        android:background="@drawable/bg_link_own_badge"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/design_spacing_compact"
        android:paddingVertical="2dp"
        android:text="@string/links_mine"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSecondaryContainer"
        android:visibility="gone"
        tools:visibility="visible" />

    <include
        android:id="@+id/votes"
        layout="@layout/view_link_vote_pill"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/design_touch_target"
        android:visibility="gone" />

</LinearLayout>
