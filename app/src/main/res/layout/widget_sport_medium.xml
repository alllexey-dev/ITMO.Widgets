<?xml version="1.0" encoding="utf-8"?>
<!-- W3, medium (4 x 2): the score ring, how far the credit is, the legend and the nearest bookings or queues. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_rounded"
    android:clipToOutline="true"
    tools:ignore="UseAppTint">

    <include layout="@layout/widget_theme_background" />

    <LinearLayout
        android:id="@+id/sport_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp">

            <include layout="@layout/widget_sport_ring" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sport_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp"
                tools:text="Ещё 70 баллов до зачёта" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <android.widget.ImageView
                    android:id="@+id/sport_visits_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/shape_circle_filled" />

                <TextView
                    android:id="@+id/sport_visits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="12sp"
                    tools:text="посещения 15" />

                <android.widget.ImageView
                    android:id="@+id/sport_bonus_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/shape_circle_filled" />

                <TextView
                    android:id="@+id/sport_bonus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="12sp"
                    tools:text="бонусы 15" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/sport_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="14dp">

        <include layout="@layout/widget_message" />
    </FrameLayout>
</FrameLayout>
