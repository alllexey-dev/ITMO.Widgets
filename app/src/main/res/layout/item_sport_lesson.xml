<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/design_screen_margin"
    android:paddingVertical="@dimen/design_spacing_related">
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.ItmoWidgets.Card.Content.Outlined"
        android:id="@+id/sport_lesson_card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">
        <LinearLayout
            android:id="@+id/lesson_card_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/design_card_padding"
            android:orientation="vertical">
            <TextView
                android:id="@+id/section_name_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="2"
                android:ellipsize="end"
                android:breakStrategy="balanced" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/design_spacing_related"
                android:layout_marginBottom="@dimen/design_spacing_related">
                <TextView
                    android:id="@+id/time_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"
                    android:layout_marginEnd="@dimen/design_spacing_compact" />
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        android:layout_gravity="end">
                        <TextView
                            android:id="@+id/type_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:paddingHorizontal="@dimen/design_spacing_compact"
                            android:paddingVertical="3dp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
                <ImageView
                    android:id="@+id/intersection_indicator"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="@dimen/design_spacing_compact"
                    android:src="@drawable/ic_error_rounded"
                    android:contentDescription="@string/sport_intersection_description"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/teacher_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/design_spacing_related"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="@dimen/design_spacing_compact"
                    android:src="@drawable/ic_person_rounded"
                    android:contentDescription="@null"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:id="@+id/teacher_text_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/location_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/design_spacing_related"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="@dimen/design_spacing_compact"
                    android:src="@drawable/ic_location_on_rounded"
                    android:contentDescription="@null"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:id="@+id/location_text_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <include
                android:id="@+id/friends_preview"
                layout="@layout/item_sport_friends" />
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/occupancy_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/design_spacing_content"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="?attr/colorOutlineVariant"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp"
                android:importantForAccessibility="no"
                app:indicatorTrackGapSize="0dp"
                app:trackStopIndicatorSize="0dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/design_spacing_related"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/design_spacing_compact"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/signed_up_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_up_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:minHeight="@dimen/design_touch_target"
                    android:minWidth="0dp"
                    android:paddingHorizontal="@dimen/design_spacing_content"
                    android:paddingVertical="0dp"
                    android:insetTop="6dp"
                    android:insetBottom="6dp"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:text="@string/sport_lesson_sign_up" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
