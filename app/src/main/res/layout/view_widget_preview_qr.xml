<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- The 2 x 2 widget at its launcher size, fitted to the card (QrSettingsPreview sets the size). -->
    <dev.alllexey.itmowidgets.core.ui.widget.WidgetPreviewFrame
        android:id="@+id/qr_preview_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/qr_preview_widget"
            layout="@layout/widget_qr_code" />
    </dev.alllexey.itmowidgets.core.ui.widget.WidgetPreviewFrame>

    <TextView
        android:id="@+id/qr_preview_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:text="@string/widget_preview_qr_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnPrimaryContainer" />

</LinearLayout>
