<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/auth_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/auth_initializing" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/auth_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="64dp"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/auth_logo"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@null"
                android:src="@drawable/auth_logo"
                app:tint="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/auth_reauth_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/auth_reauthentication_description"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/design_spacing_section"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.ItmoWidgets.FeatureRow"
                    android:layout_width="wrap_content"
                    android:text="@string/auth_feature_widgets"
                    app:drawableStartCompat="@drawable/ic_schedule" />

                <TextView
                    style="@style/Widget.ItmoWidgets.FeatureRow"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/design_spacing_content"
                    android:text="@string/auth_feature_sport"
                    app:drawableStartCompat="@drawable/ic_exercise" />

                <TextView
                    style="@style/Widget.ItmoWidgets.FeatureRow"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/design_spacing_content"
                    android:text="@string/auth_feature_friends"
                    app:drawableStartCompat="@drawable/ic_group" />

            </LinearLayout>

            <TextView
                android:id="@+id/auth_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/itmo_id_login_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:minHeight="48dp"
                android:text="@string/auth_login_itmo_id"
                app:icon="@drawable/ic_login"
                app:iconGravity="textStart"
                app:iconTint="?attr/colorOnPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refresh_token_login_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/auth_login_refresh_token" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/manual_login_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/auth_signing_in"
                android:visibility="gone"
                app:indicatorSize="32dp"
                app:trackThickness="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/auth_official_page_notice"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
