<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:transitionGroup="true"
    tools:context=".feature.social.ui.UserProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/user_profile_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/design_screen_margin"
                android:paddingBottom="@dimen/design_spacing_group">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/design_spacing_group">

                    <dev.alllexey.itmowidgets.core.ui.AvatarView
                        android:id="@+id/avatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/design_spacing_group"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="Иванов Иван Иванович" />

                        <TextView
                            android:id="@+id/group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/design_spacing_related"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone"
                            tools:text="M3100 • 1 курс • ФИТиП"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/design_spacing_related"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="ИСУ 123456" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/relationship_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/design_spacing_compact"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="Хочет добавить вас"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/primary_action"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="@dimen/design_touch_target"
                        tools:text="Добавить в друзья" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/secondary_action"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/design_spacing_compact"
                        android:minHeight="@dimen/design_touch_target"
                        android:visibility="gone"
                        tools:text="Отклонить"
                        tools:visibility="visible" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.ItmoWidgets.CompactSettingsCard"
                    android:layout_marginTop="@dimen/design_spacing_section">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/friends_row"
                            style="@style/Widget.ItmoWidgets.CompactSettingsRow"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/friends_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_group"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <LinearLayout style="@style/Widget.ItmoWidgets.CompactSettingsRowText">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/friends_title"
                                    android:textAppearance="?attr/textAppearanceBodyLarge"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/friends_description"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    tools:text="Пары на ближайшие недели" />

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/friends_trailing"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <View
                            style="@style/Widget.ItmoWidgets.CompactSettingsDivider"
                            android:layout_marginStart="56dp" />

                        <LinearLayout
                            android:id="@+id/schedule_row"
                            style="@style/Widget.ItmoWidgets.CompactSettingsRow"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/schedule_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_schedule"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <LinearLayout style="@style/Widget.ItmoWidgets.CompactSettingsRowText">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/user_profile_schedule_title"
                                    android:textAppearance="?attr/textAppearanceBodyLarge"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/schedule_description"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    tools:text="Пары на ближайшие недели" />

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/schedule_trailing"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <View
                            style="@style/Widget.ItmoWidgets.CompactSettingsDivider"
                            android:layout_marginStart="56dp" />

                        <LinearLayout
                            android:id="@+id/sport_row"
                            style="@style/Widget.ItmoWidgets.CompactSettingsRow"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/sport_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_exercise"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <LinearLayout style="@style/Widget.ItmoWidgets.CompactSettingsRowText">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/user_profile_sport_title"
                                    android:textAppearance="?attr/textAppearanceBodyLarge"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/sport_description"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    tools:text="Записи и ожидающие занятия" />

                            </LinearLayout>

                            <ImageView
                                android:id="@+id/sport_trailing"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/hidden_hint"
                    style="@style/Widget.ItmoWidgets.CompactSettingsSectionFooter"
                    android:text="@string/user_profile_hidden_friends_hint"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </ScrollView>

        <dev.alllexey.itmowidgets.core.ui.SkeletonView
            android:id="@+id/loading"
            style="@style/Widget.ItmoWidgets.Skeleton.List"
            android:visibility="gone"
            app:skeletonRows="3" />

        <LinearLayout
            android:id="@+id/state_container"
            style="@style/Widget.ItmoWidgets.ContentState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/state_icon"
                style="@style/Widget.ItmoWidgets.ContentState.Icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_person" />

            <TextView
                android:id="@+id/state_title"
                style="@style/Widget.ItmoWidgets.ContentState.Title" />

            <TextView
                android:id="@+id/state_description"
                style="@style/Widget.ItmoWidgets.ContentState.Description" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/state_action"
                style="@style/Widget.ItmoWidgets.ContentState.Action"
                android:text="@string/common_retry" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
