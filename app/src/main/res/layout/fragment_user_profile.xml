<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:transitionGroup="true"
    tools:context=".feature.social.ui.UserProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="@string/user_profile_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/share_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share_action"
            android:padding="12dp"
            android:src="@drawable/ic_share"
            android:visibility="gone"
            app:tint="?attr/colorOnSurface"
            tools:visibility="visible" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profile_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/design_screen_margin"
            android:paddingBottom="@dimen/design_spacing_group"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_profile_header"
            tools:visibility="visible" />

        <dev.alllexey.itmowidgets.core.ui.SkeletonView
            android:id="@+id/loading"
            style="@style/Widget.ItmoWidgets.Skeleton.List"
            android:visibility="gone"
            app:skeletonRows="3" />

        <LinearLayout
            android:id="@+id/state_container"
            style="@style/Widget.ItmoWidgets.ContentState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/state_icon"
                style="@style/Widget.ItmoWidgets.ContentState.Icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_person" />

            <TextView
                android:id="@+id/state_title"
                style="@style/Widget.ItmoWidgets.ContentState.Title" />

            <TextView
                android:id="@+id/state_description"
                style="@style/Widget.ItmoWidgets.ContentState.Description" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/state_action"
                style="@style/Widget.ItmoWidgets.ContentState.Action"
                android:text="@string/common_retry" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
