<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.button.MaterialButton android:id="@+id/close_button"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:minWidth="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="12dp"
        android:contentDescription="@string/common_close"
        app:icon="@drawable/ic_close"
        app:iconPadding="0dp"
        app:iconTint="?attr/colorOnSurface" />

    <!-- The whole offer scrolls: three stacked actions and release notes outgrow a tall font scale. -->
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout style="@style/Widget.ItmoWidgets.ContentState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView android:id="@+id/update_icon"
                style="@style/Widget.ItmoWidgets.ContentState.Icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_download" />

            <TextView android:id="@+id/update_title"
                style="@style/Widget.ItmoWidgets.ContentState.Title"
                tools:text="@string/app_update_title" />

            <TextView android:id="@+id/update_versions"
                style="@style/Widget.ItmoWidgets.ContentState.Description"
                android:layout_marginTop="@dimen/design_spacing_related"
                android:textColor="?attr/colorPrimary"
                tools:text="2.1 → 2.2" />

            <TextView android:id="@+id/update_description"
                style="@style/Widget.ItmoWidgets.ContentState.Description"
                tools:text="@string/app_update_description" />

            <com.google.android.material.button.MaterialButton android:id="@+id/update_button"
                style="@style/Widget.ItmoWidgets.ContentState.PrimaryAction"
                android:text="@string/app_update_action" />

            <com.google.android.material.button.MaterialButton android:id="@+id/later_button"
                style="@style/Widget.ItmoWidgets.ContentState.Action"
                android:layout_marginTop="@dimen/design_spacing_compact"
                android:text="@string/app_update_later" />

            <com.google.android.material.button.MaterialButton android:id="@+id/skip_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/design_spacing_related"
                android:minHeight="@dimen/design_touch_target"
                android:text="@string/app_update_skip" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
