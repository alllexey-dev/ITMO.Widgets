<?xml version="1.0" encoding="utf-8"?>
<!--
    The viewer's own review, first in the reviews group: «мой» and its state with ⋮, the subject and how others see it,
    a rejection reason, the text and, once published, the verification and the read-only score.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/design_card_padding"
    android:paddingTop="@dimen/design_spacing_related"
    android:paddingEnd="@dimen/design_spacing_related"
    android:paddingBottom="@dimen/design_spacing_related">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/design_touch_target"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/own_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_link_own_badge"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/design_spacing_compact"
            android:paddingVertical="2dp"
            android:text="@string/teacher_review_mine_badge"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSecondaryContainer" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/design_spacing_compact"
            android:background="@drawable/bg_review_pill"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:visibility="gone"
            tools:backgroundTint="@color/review_verified_container"
            tools:text="На проверке"
            tools:textColor="?attr/colorTertiary"
            tools:visibility="visible" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/more"
            android:layout_width="@dimen/design_touch_target"
            android:layout_height="@dimen/design_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/teacher_review_actions"
            android:padding="@dimen/design_spacing_content"
            android:src="@drawable/ic_more_vert_rounded"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/design_spacing_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Математический анализ, анонимно" />

    <TextView
        android:id="@+id/reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/design_spacing_related"
        android:layout_marginEnd="@dimen/design_spacing_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/design_spacing_related"
        android:layout_marginEnd="@dimen/design_spacing_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface" />

    <dev.alllexey.itmowidgets.feature.social.ui.ReviewFooterLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/design_spacing_related"
        android:minHeight="@dimen/design_touch_target">

        <LinearLayout
            android:id="@+id/origin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/verified"
                layout="@layout/view_review_verified" />

            <TextView
                android:id="@+id/unverified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/teacher_review_unverified"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

        <include
            android:id="@+id/votes"
            layout="@layout/view_link_vote_pill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/design_touch_target" />

    </dev.alllexey.itmowidgets.feature.social.ui.ReviewFooterLayout>

</LinearLayout>
