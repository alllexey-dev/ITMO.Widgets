<?xml version="1.0" encoding="utf-8"?>
<!-- The viewer's own review, first in the list: its state, how others see it, its text and, once published, its score. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.ItmoWidgets.Card.Content.Own"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/design_card_padding"
        android:paddingTop="@dimen/design_spacing_related"
        android:paddingEnd="@dimen/design_spacing_related"
        android:paddingBottom="@dimen/design_card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/design_touch_target"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/design_spacing_compact"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_review_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:visibility="gone"
                    tools:backgroundTint="@color/review_verified_container"
                    tools:text="На проверке"
                    tools:textColor="?attr/colorTertiary"
                    tools:visibility="visible" />

                <include
                    android:id="@+id/verified"
                    layout="@layout/view_review_verified" />

                <TextView
                    android:id="@+id/unverified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/teacher_review_unverified"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

            </FrameLayout>

            <ImageButton
                android:id="@+id/more"
                android:layout_width="@dimen/design_touch_target"
                android:layout_height="@dimen/design_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/teacher_review_actions"
                android:padding="@dimen/design_spacing_content"
                android:src="@drawable/ic_more_vert_rounded"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/design_spacing_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Ваш отзыв · Математический анализ · анонимно" />

        <TextView
            android:id="@+id/reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/design_spacing_related"
            android:layout_marginEnd="@dimen/design_spacing_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="Причина: оскорбительные выражения"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/design_spacing_related"
            android:layout_marginEnd="@dimen/design_spacing_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Понятно объясняет материал и подробно отвечает на вопросы." />

        <TextView
            android:id="@+id/score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/design_spacing_compact"
            android:layout_marginEnd="@dimen/design_spacing_content"
            android:drawablePadding="2dp"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_arrow_upward_alt"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            tools:text="3"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
