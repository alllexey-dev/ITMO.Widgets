<?xml version="1.0" encoding="utf-8"?>
<!--
    The viewer's own review, a group of its own above the others: «мой» and its state with ⋮, the subject and how
    others see it, a rejection reason, the text and, once published, the verification and the read-only score.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/design_card_padding"
    android:paddingTop="@dimen/design_spacing_related"
    android:paddingEnd="@dimen/design_spacing_related"
    android:paddingBottom="@dimen/design_spacing_related">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/design_touch_target"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/own_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_link_own_badge"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/design_spacing_compact"
            android:paddingVertical="2dp"
            android:text="@string/teacher_review_mine_badge"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSecondaryContainer" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/design_spacing_compact"
            android:background="@drawable/bg_review_pill"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:visibility="gone"
            tools:text="На проверке"
            tools:textColor="?attr/colorTertiary"
            tools:visibility="visible" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/more"
            android:layout_width="@dimen/design_touch_target"
            android:layout_height="@dimen/design_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/teacher_review_actions"
            android:padding="@dimen/design_spacing_content"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/design_spacing_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Математический анализ, анонимно" />

    <TextView
        android:id="@+id/reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/design_spacing_related"
        android:layout_marginEnd="@dimen/design_spacing_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/design_spacing_related"
        android:layout_marginEnd="@dimen/design_spacing_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface" />

    <!-- Once published: the verification on the left, the read-only score centred on it on the right. -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_marginTop="@dimen/design_spacing_compact"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/design_spacing_compact"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- An ImageView, not a compound drawable: the check is 16 dp, which a compound drawable cannot be in XML. -->
            <LinearLayout
                android:id="@+id/verified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="UseCompoundDrawables"
                                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="@dimen/design_spacing_related"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/verified_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/teacher_review_verified"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

            <TextView
                android:id="@+id/unverified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                                android:text="@string/teacher_review_unverified"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

        <include
            android:id="@+id/votes"
            layout="@layout/view_link_vote_pill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/design_touch_target" />

    </LinearLayout>

</LinearLayout>
