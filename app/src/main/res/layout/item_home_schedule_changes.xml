<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/design_screen_margin"
    android:paddingVertical="@dimen/design_spacing_related">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/home_schedule_changes_card"
        style="@style/Widget.ItmoWidgets.Card.Content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/design_card_padding"
            android:paddingTop="@dimen/design_spacing_related"
            android:paddingEnd="@dimen/design_spacing_related"
            android:paddingBottom="@dimen/design_card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="@dimen/design_spacing_compact"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_edit_calendar"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/schedule_changes_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/schedule_changes_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/schedule_changes_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/design_spacing_compact"
                    android:background="@drawable/bg_home_badge"
                    android:paddingHorizontal="@dimen/design_spacing_compact"
                    android:paddingVertical="2dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    tools:text="3" />

                <ImageButton
                    android:id="@+id/schedule_changes_dismiss"
                    android:layout_width="@dimen/design_touch_target"
                    android:layout_height="@dimen/design_touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/home_schedule_changes_dismiss"
                    android:padding="@dimen/design_spacing_content"
                    android:src="@drawable/ic_close_rounded"
                    app:tint="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <TextView
                android:id="@+id/schedule_changes_latest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/design_spacing_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Математический анализ — перенесена на ср, 9 сентября, 10:00" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
