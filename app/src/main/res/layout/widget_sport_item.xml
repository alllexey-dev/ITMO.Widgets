<?xml version="1.0" encoding="utf-8"?>
<!-- A booking or queue of the sport widget: time and status, section and building; the nearest on a tonal block. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    tools:ignore="UseAppTint">

    <android.widget.ImageView
        android:id="@+id/item_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_block" />

    <LinearLayout
        android:id="@+id/item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <android.widget.ImageView
            android:id="@+id/item_bar"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_shape_bar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/item_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="12sp"
                    tools:text="Завтра 15:20" />

                <TextView
                    android:id="@+id/item_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/widget_pill_warn"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="1dp"
                    android:textColor="@color/widget_on_warn_container"
                    android:textSize="12sp"
                    tools:text="очередь 2 из 5" />
            </LinearLayout>

            <TextView
                android:id="@+id/item_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp"
                tools:text="Плавание, Ломо" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
