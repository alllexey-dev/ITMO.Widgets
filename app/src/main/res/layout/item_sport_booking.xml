<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/design_screen_margin"
    android:paddingVertical="@dimen/design_spacing_related">
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.ItmoWidgets.Card.Content.Outlined"
        android:id="@+id/sport_record_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/design_card_padding"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/title_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:breakStrategy="balanced"
                    android:layout_marginEnd="56dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginTop="@dimen/design_spacing_compact">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="noHideDescendants"
                        app:cardBackgroundColor="?attr/colorSecondaryContainer"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="@dimen/design_spacing_compact"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/date_day_text_view"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="?attr/colorOnSecondaryContainer"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/date_month_text_view"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textAllCaps="true"
                                android:textColor="?attr/colorOnSecondaryContainer"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/design_spacing_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/date_text_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        <TextView
                            android:id="@+id/time_text_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:id="@+id/status_text_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:drawablePadding="8dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/teacher_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/design_spacing_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    tools:ignore="UseCompoundDrawables">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="@dimen/design_spacing_compact"
                        android:src="@drawable/ic_person_rounded"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/teacher_text_view"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/location_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/design_spacing_related"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    tools:ignore="UseCompoundDrawables">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="@dimen/design_spacing_compact"
                        android:src="@drawable/ic_location_on_rounded"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/location_text_view"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
                <include
                    android:id="@+id/friends_preview"
                    layout="@layout/item_sport_friends" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/options_menu"
                android:layout_width="@dimen/design_touch_target"
                android:layout_height="@dimen/design_touch_target"
                android:layout_marginEnd="@dimen/design_spacing_compact"
                android:layout_marginTop="@dimen/design_spacing_compact"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/common_options"
                android:padding="@dimen/design_spacing_content"
                android:src="@drawable/ic_more_vert_rounded"
                app:tint="?attr/colorOnSurfaceVariant"
                android:layout_gravity="top|end" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
