<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:transitionGroup="true"
    tools:context=".feature.me.ui.MeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="16dp">

            <dev.alllexey.itmowidgets.core.ui.AvatarView
                android:id="@+id/profile_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="Иванов Иван Иванович" />

                <TextView
                    android:id="@+id/profile_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="M3100 • 1 курс • ФИТиП"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/profile_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="ИСУ 123456" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/Widget.ItmoWidgets.CompactSettingsGroupLabel"
            android:layout_marginTop="0dp"
            android:text="@string/me_group_social" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ItmoWidgets.CompactSettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/friends_row"
                    style="@style/Widget.ItmoWidgets.CompactSettingsRow"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_group"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout style="@style/Widget.ItmoWidgets.CompactSettingsRowText">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/me_friends_title"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/friends_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="12" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/requests_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_friend_selection_badge"
                        android:minWidth="24dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnPrimary"
                        android:visibility="gone"
                        tools:text="2"
                        tools:visibility="visible" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <View
                    android:id="@+id/find_people_divider"
                    style="@style/Widget.ItmoWidgets.CompactSettingsDivider"
                    android:layout_marginStart="56dp" />

                <LinearLayout
                    android:id="@+id/find_people_row"
                    style="@style/Widget.ItmoWidgets.CompactSettingsRow"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout style="@style/Widget.ItmoWidgets.CompactSettingsRowText">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/me_find_people_title"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/me_find_people_description"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <View
                    android:id="@+id/privacy_divider"
                    style="@style/Widget.ItmoWidgets.CompactSettingsDivider"
                    android:layout_marginStart="56dp" />

                <LinearLayout
                    android:id="@+id/privacy_row"
                    style="@style/Widget.ItmoWidgets.CompactSettingsRow"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout style="@style/Widget.ItmoWidgets.CompactSettingsRowText">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/me_privacy_title"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/me_privacy_description"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/services_disabled_row"
                    style="@style/Widget.ItmoWidgets.CompactSettingsRow"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_globe"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout style="@style/Widget.ItmoWidgets.CompactSettingsRowText">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/me_services_disabled_title"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/me_services_disabled_description"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.ItmoWidgets.CompactSettingsGroupLabel"
            android:text="@string/me_group_app" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ItmoWidgets.CompactSettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/settings_row"
                    style="@style/Widget.ItmoWidgets.CompactSettingsRow"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        style="@style/Widget.ItmoWidgets.SettingsRowText"
                        android:text="@string/settings_title"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <View
                    android:id="@+id/debug_divider"
                    style="@style/Widget.ItmoWidgets.CompactSettingsDivider"
                    android:layout_marginStart="56dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/debug_tools_row"
                    style="@style/Widget.ItmoWidgets.CompactSettingsRow"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_outline_code_blocks"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        style="@style/Widget.ItmoWidgets.SettingsRowText"
                        android:text="@string/debug_tools_title"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/github_button"
                style="@style/Widget.ItmoWidgets.ProjectLink"
                android:contentDescription="@string/me_github_accessibility"
                android:text="@string/me_github"
                app:icon="@drawable/ic_github" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/telegram_button"
                style="@style/Widget.ItmoWidgets.ProjectLink"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/me_telegram_accessibility"
                android:text="@string/me_telegram"
                app:icon="@drawable/ic_telegram" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sign_out_row"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/me_sign_out"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:icon="@drawable/ic_logout"
            app:iconTint="?attr/colorOnSurfaceVariant" />


    </LinearLayout>

</ScrollView>
