<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/my_itmo_web_title"
        app:subtitleTextAppearance="@style/TextAppearance.Material3.BodySmall"
        app:subtitleTextColor="?attr/colorOnSurfaceVariant"
        app:navigationIcon="@drawable/ic_close_rounded"
        app:navigationIconTint="?attr/colorOnSurface"
        app:navigationContentDescription="@string/common_close"
        app:menu="@menu/my_itmo_web_menu" />
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        app:trackThickness="4dp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <LinearLayout
            android:id="@+id/state_container"
            style="@style/Widget.ItmoWidgets.ContentState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <ImageView
                style="@style/Widget.ItmoWidgets.ContentState.Icon"
                android:contentDescription="@null"
                android:src="@drawable/ic_error_rounded" />
            <TextView
                style="@style/Widget.ItmoWidgets.ContentState.Title"
                android:text="@string/my_itmo_web_error_title" />
            <TextView
                style="@style/Widget.ItmoWidgets.ContentState.Description"
                android:text="@string/my_itmo_web_error_description" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/state_action"
                style="@style/Widget.ItmoWidgets.ContentState.Action"
                android:text="@string/common_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
