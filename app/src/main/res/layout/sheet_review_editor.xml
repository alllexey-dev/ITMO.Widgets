<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/design_spacing_group">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/design_spacing_compact"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/design_screen_margin"
            android:paddingEnd="@dimen/design_spacing_related">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="@dimen/design_spacing_compact">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    tools:targetApi="p"
                    tools:text="Новый отзыв" />

                <TextView
                    android:id="@+id/teacher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hyphenationFrequency="normal"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:targetApi="m"
                    tools:text="Иванов И. И." />

            </LinearLayout>

            <ImageButton
                android:id="@+id/close"
                android:layout_width="@dimen/design_touch_target"
                android:layout_height="@dimen/design_touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/review_editor_close"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/subject_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/design_screen_margin"
            android:layout_marginTop="@dimen/design_spacing_compact"
            android:hint="@string/review_subject_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Subjects of the viewer's own lessons with the teacher; a tap fills the field. -->
        <HorizontalScrollView
            android:id="@+id/suggestions_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/design_spacing_related"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/design_screen_margin"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/suggestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true" />

        </HorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/text_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/design_screen_margin"
            android:layout_marginTop="@dimen/design_spacing_compact"
            android:hint="@string/review_text_hint"
            app:counterEnabled="true"
            app:counterMaxLength="3000"
            app:helperTextEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="5" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/anonymous"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/design_screen_margin"
            android:layout_marginTop="@dimen/design_spacing_compact"
            android:minHeight="@dimen/design_touch_target"
            android:text="@string/review_anonymous"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/anonymous_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/design_screen_margin"
            android:text="@string/review_anonymous_off"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/design_screen_margin"
            android:layout_marginTop="@dimen/design_spacing_group"
            android:minHeight="@dimen/design_touch_target"
            android:text="@string/review_send" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
