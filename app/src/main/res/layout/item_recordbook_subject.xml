<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.ItmoWidgets.Card.Content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/design_spacing_related"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="@dimen/design_touch_target"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/design_card_padding"
        android:paddingVertical="@dimen/design_spacing_content">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/design_spacing_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:id="@+id/name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:breakStrategy="high_quality"
                    android:ellipsize="end"
                    android:hyphenationFrequency="normal"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Математический анализ (продвинутый уровень)" />

                <ImageView android:id="@+id/new_mark"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="@dimen/design_spacing_compact"
                    android:contentDescription="@null"
                    android:src="@drawable/shape_circle_filled"
                    android:visibility="gone"
                    app:tint="?attr/colorPrimary"
                    tools:visibility="visible" />

            </LinearLayout>

            <TextView android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="normal"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Экзамен" />

        </LinearLayout>

        <LinearLayout android:id="@+id/score_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:importantForAccessibility="noHideDescendants"
            android:minWidth="64dp"
            android:orientation="vertical">

            <!-- A total from a connected sheet carries the table mark and no bar. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView android:id="@+id/sheet_mark"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_table"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurfaceVariant"
                    tools:visibility="visible" />

                <TextView android:id="@+id/score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:maxWidth="96dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="48,5" />

            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/design_spacing_related"
                android:max="1000"
                app:trackThickness="4dp"
                app:trackCornerRadius="2dp"
                app:trackStopIndicatorSize="0dp"
                app:indicatorTrackGapSize="0dp"
                app:trackColor="?attr/colorOutlineVariant" />

        </LinearLayout>

        <TextView android:id="@+id/grade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_grade_badge"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:minWidth="48dp"
            android:paddingHorizontal="@dimen/design_spacing_compact"
            android:paddingVertical="@dimen/design_spacing_related"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:visibility="gone"
            tools:text="4C"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
