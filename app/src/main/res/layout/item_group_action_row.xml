<?xml version="1.0" encoding="utf-8"?>
<!-- The last row of a connected group that leads further: «Все ссылки, N», «Добавить ссылку», «Все пары, N». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/design_card_padding"
    android:paddingTop="@dimen/design_spacing_compact"
    android:paddingEnd="@dimen/design_spacing_content"
    android:paddingBottom="@dimen/design_spacing_compact">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/design_card_padding"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:tint="?attr/colorOnSurfaceVariant"
        tools:src="@drawable/ic_add" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="Все ссылки, 5" />

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/design_spacing_compact"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
