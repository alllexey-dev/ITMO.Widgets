<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/design_screen_margin"
    android:paddingVertical="@dimen/design_spacing_related">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/home_friends_card"
        style="@style/Widget.ItmoWidgets.Card.Content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/design_card_padding"
            android:paddingBottom="@dimen/design_spacing_compact">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/design_card_padding">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="@dimen/design_spacing_compact"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_group"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_friends_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/friends_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_badge"
                    android:paddingHorizontal="@dimen/design_spacing_compact"
                    android:paddingVertical="2dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    tools:text="2" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/friends_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/design_spacing_compact"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/friends_all"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/design_spacing_compact"
                android:minHeight="@dimen/design_touch_target"
                android:text="@string/home_friends_all" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
