<?xml version="1.0" encoding="utf-8"?>
<!-- A following lesson of the medium next-lesson widget: time, type bar, subject, room and building or the queue. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rest_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="horizontal"
    tools:ignore="UseAppTint">

    <android.widget.ImageView
        android:id="@+id/rest_bar"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shape_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rest_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp"
            tools:text="15:20–16:50" />

        <TextView
            android:id="@+id/rest_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            tools:text="Английский язык" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <android.widget.ImageView
                android:id="@+id/rest_online_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_videocam"
                android:visibility="gone" />

            <TextView
                android:id="@+id/rest_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp"
                tools:text="бассейн, Ломо" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
