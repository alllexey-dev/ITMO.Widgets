<?xml version="1.0" encoding="utf-8"?>
<!-- «▲ N ▼»: 48 dp arrow targets overlap the score by 12 dp each; the visible pill is 32 dp high. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/design_touch_target"
    android:background="@drawable/bg_link_vote_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="0dp">

    <ImageButton
        android:id="@+id/vote_up"
        android:layout_width="@dimen/design_touch_target"
        android:layout_height="@dimen/design_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/links_vote_up"
        android:src="@drawable/ic_arrow_drop_up"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="-12dp"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:maxLines="1"
        android:minWidth="16dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="12" />

    <ImageButton
        android:id="@+id/vote_down"
        android:layout_width="@dimen/design_touch_target"
        android:layout_height="@dimen/design_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/links_vote_down"
        android:src="@drawable/ic_arrow_drop_down"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
