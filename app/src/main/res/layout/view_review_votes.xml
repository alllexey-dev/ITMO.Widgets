<?xml version="1.0" encoding="utf-8"?>
<!-- Arrows keep 48 dp targets; the score tucks into their padding so the group reads compact. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/vote_up"
        android:layout_width="@dimen/design_touch_target"
        android:layout_height="@dimen/design_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/teacher_review_vote_up"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_upward_alt"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="-10dp"
        android:gravity="center"
        android:maxLines="1"
        android:minWidth="20dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="12" />

    <ImageButton
        android:id="@+id/vote_down"
        android:layout_width="@dimen/design_touch_target"
        android:layout_height="@dimen/design_touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/teacher_review_vote_down"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_arrow_downward_alt"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
