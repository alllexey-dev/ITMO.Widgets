<?xml version="1.0" encoding="utf-8"?>
<!-- Cards: placed at 4 x 4, resizable down to 4 x 2 (the header and one card). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_cards_description"
    android:initialKeyguardLayout="@layout/widget_cards"
    android:initialLayout="@layout/widget_cards"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_cards_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
