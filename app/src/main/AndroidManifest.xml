<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Asked only when calendar synchronization is turned on or a calendar is picked. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- WorkManager's foreground service: no worker calls setForeground, and Play asks to declare any FGS. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <!-- «Открыть в календаре» for an exported .ics shows only when an app can open it. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="text/calendar" />
        </intent>
    </queries>

    <application
        android:name=".app.ItmoWidgetsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Play installs the QR scanner module with the app instead of on the first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <service
            android:name=".core.notification.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Shared profile and sport lesson links; verified against /.well-known/assetlinks.json of each host. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="widgets.alllexey.dev" />
                <data android:host="dev.widgets.alllexey.dev" />
                <data android:pathPrefix="/u/" />
                <data android:pathPrefix="/sport/" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".feature.recordbook.ui.BarsLoginActivity"
            android:exported="false" />

        <service
            android:name=".feature.qr.ui.QrTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_qr"
            android:label="@string/qr_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".feature.auth.ui.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".core.ui.spoiler.SpoilerCropActivity"
            android:exported="false" />

        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            tools:node="remove" />

        <receiver
            android:name=".feature.qr.ui.widget.QrCodeWidgetProvider"
            android:exported="false"
            android:label="@string/widget_qr_code_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.alllexey.itmowidgets.action.QR_WIDGET_CLICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_qr_code_info" />
        </receiver>

        <receiver
            android:name=".feature.schedule.ui.widget.SingleLessonWidgetProvider"
            android:exported="false"
            android:label="@string/widget_single_lesson_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_single_lesson_info" />
        </receiver>

        <receiver
            android:name=".feature.schedule.ui.widget.DayScheduleWidgetProvider"
            android:exported="false"
            android:label="@string/widget_lesson_list_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lesson_list_info" />
        </receiver>

        <receiver
            android:name=".feature.schedule.work.ScheduleWidgetRefreshReceiver"
            android:exported="false" />

        <receiver
            android:name=".app.WidgetBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <service
            android:name=".feature.schedule.ui.widget.ScheduleWidgetRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

    </application>

</manifest>
