package dev.alllexey.itmowidgets.feature.__name__.ui

import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.setValue
import androidx.compose.ui.test.ExperimentalTestApi
import androidx.compose.ui.test.onNodeWithContentDescription
import androidx.compose.ui.test.onNodeWithTag
import androidx.compose.ui.test.onNodeWithText
import androidx.compose.ui.test.performClick
import androidx.compose.ui.test.v2.runComposeUiTest
import dev.alllexey.itmowidgets.core.result.AppError
import dev.alllexey.itmowidgets.designsystem.theme.ItmoTheme
import dev.alllexey.itmowidgets.feature.__name__.domain.__Name__Summary
import dev.alllexey.itmowidgets.feature.__name__.presentation.__Name__UiState
import dev.alllexey.itmowidgets.testkit.RobolectricTestRunner
import dev.alllexey.itmowidgets.testkit.RunWith
import dev.alllexey.itmowidgets.testkit.assertTouchTargets
import kotlin.test.Test
import kotlin.test.assertEquals

@OptIn(ExperimentalTestApi::class)
@RunWith(RobolectricTestRunner::class)
class __Name__ScreenTest {

    @Test
    fun everyStateShowsItsNodeWithTouchTargetsAndTheCallbacksFire() = runComposeUiTest {
        var state by mutableStateOf<__Name__UiState>(__Name__UiState.Loading)
        var refreshes = 0
        var backs = 0
        setContent {
            ItmoTheme { __Name__Screen(state, onRefresh = { refreshes++ }, onBack = { backs++ }) }
        }

        onNodeWithTag(__Name__TestTags.LOADING).assertExists()
        assertTouchTargets()

        state = __Name__UiState.Content(__Name__Summary("ITMO-TEST"))
        waitForIdle()
        onNodeWithTag(__Name__TestTags.CONTENT).assertExists()
        assertTouchTargets()

        state = __Name__UiState.Error(AppError.Network)
        waitForIdle()
        onNodeWithTag(__Name__TestTags.STATE).assertExists()
        assertTouchTargets()
        onNodeWithText("Повторить").performClick()
        onNodeWithContentDescription("Назад").performClick()

        assertEquals(1, refreshes)
        assertEquals(1, backs)
    }
}
