/** Test tags of [__Name__Screen], read by host tests and the platform hosts. */
object __Name__TestTags {
    const val LOADING = "__name___loading"
    const val STATE = "__name___state"
    const val CONTENT = "__name___content"
}

/**
 * The __name__ screen: loading, content and error take the same area, so states switch without a layout jump.
 * Stateless; [__Name__Route] feeds it. Failed refreshes over content show in [snackbarHostState].
 */
@Composable
fun __Name__Screen(
    state: __Name__UiState,
    onRefresh: () -> Unit,
    onBack: () -> Unit,
    modifier: Modifier = Modifier,
    snackbarHostState: SnackbarHostState = remember { SnackbarHostState() },
) {
    Box(modifier.fillMaxSize().background(ItmoTheme.colorScheme.surface)) {
        Column(Modifier.fillMaxSize()) {
            AppTopBar(
                title = stringResource(Res.string.__name___title),
                navigation = {
                    AppTopBarAction(
                        painterResource(KitRes.drawable.ic_arrow_back),
                        stringResource(CoreRes.string.common_back),
                        onClick = onBack,
                    )
                },
            )
            Box(Modifier.weight(1f).fillMaxWidth(), contentAlignment = Alignment.Center) {
                __Name__Body(state, onRefresh)
            }
        }
        SnackbarHost(snackbarHostState, Modifier.align(Alignment.BottomCenter))
    }
}

@Composable
private fun __Name__Body(state: __Name__UiState, onRefresh: () -> Unit) {
    when (state) {
        __Name__UiState.Loading -> ContentStateLoading(Modifier.testTag(__Name__TestTags.LOADING))
        is __Name__UiState.Error -> ContentState(
            title = stringResource(CoreRes.string.common_load_error_title),
            modifier = Modifier.testTag(__Name__TestTags.STATE),
            description = stringResource(state.error.textResource()),
            action = ContentStateAction(stringResource(CoreRes.string.common_retry), onRefresh),
        )
        is __Name__UiState.Content -> Text(
            state.summary.title,
            Modifier
                .fillMaxWidth()
                .padding(ItmoTheme.spacing.screenMargin)
                .testTag(__Name__TestTags.CONTENT),
            color = ItmoTheme.colorScheme.onSurface,
            style = ItmoTheme.typography.bodyLarge,
            textAlign = TextAlign.Center,
        )
    }
}
