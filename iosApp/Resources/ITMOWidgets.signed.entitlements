<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Signed builds (Signing.local.xcconfig sets ITMO_ENTITLEMENTS_VARIANT = .signed). Push (aps-environment) and associated domains go only here. -->
<dict>
	<!-- Xcode's export for App Store Connect switches it to production. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: https://<host>/u/*, /sport/*, /pair open the app (docs/features/app-links.md). Each host serves
	     /.well-known/apple-app-site-association for this app ID; both hosts in every signed build, as on Android. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:widgets.alllexey.dev</string>
		<string>applinks:dev.widgets.alllexey.dev</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_ID)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(KEYCHAIN_GROUP)</string>
	</array>
</dict>
</plist>
