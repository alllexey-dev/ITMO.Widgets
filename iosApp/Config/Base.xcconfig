// Project-wide build settings of every target (docs/ios.md, Identifiers).
// The App Group and Keychain access-group IDs live only here: Xcode expands them into each target's Info.plist
// (AppGroupID, KeychainGroup) and entitlements; Swift and Kotlin read them per process, never as literals.

APP_BUNDLE_ID = dev.alllexey.itmowidgets
APP_GROUP_ID = group.dev.alllexey.itmowidgets
KEYCHAIN_GROUP = $(AppIdentifierPrefix)dev.alllexey.itmowidgets.shared

// The Backend, BackendBaseURL in the app's Info.plist: dev for Debug, production for Release. `$()` keeps xcconfig
// from reading `//` as a comment.
BACKEND_BASE_URL = https:/$()/dev.widgets.alllexey.dev
BACKEND_BASE_URL[config=Release] = https:/$()/widgets.alllexey.dev
// The campus-map mirror (srvscripts stacks/itmomap), the same for every configuration.
CAMPUS_MAP_URL = https:/$()/map.alllexey.dev/app/v1/

// The App Store record of the app, AppStoreID in the app's Info.plist: the update offer opens
// https://apps.apple.com/app/id$(APP_STORE_ID) and offers nothing while it is empty. Empty until the App Store
// record exists.
APP_STORE_ID =

MARKETING_VERSION = 2.3.0
CURRENT_PROJECT_VERSION = 1
// iOS 26.1: the first release with `tabViewBottomAccessory(isEnabled:)` (ADR 0031, amended 2026-10-13).
IPHONEOS_DEPLOYMENT_TARGET = 26.1
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0
// Kotlin builds only iosSimulatorArm64 and iosArm64.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64

// The Run Script calls Gradle outside the sandbox (direct integration needs it).
ENABLE_USER_SCRIPT_SANDBOXING = NO

// Unsigned by default: "Sign to Run Locally" for the simulator and CI, no team. The ignored
// Signing.local.xcconfig (written locally by whoever signs) sets DEVELOPMENT_TEAM, ITMO_CODE_SIGN_IDENTITY and
// ITMO_ENTITLEMENTS_VARIANT = .signed, which switches every target to its *.signed.entitlements.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
ITMO_CODE_SIGN_IDENTITY = -
ITMO_ENTITLEMENTS_VARIANT =

#include? "Signing.local.xcconfig"
