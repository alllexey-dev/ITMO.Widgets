root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{kt,kts,java,xml,swift}]
indent_style = space
indent_size = 4

[*.{kt,kts}]
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^

[*.java]
ij_java_imports_layout = $android.**,$androidx.**,$com.**,$junit.**,$net.**,$org.**,$java.**,$javax.**,$*,|,android.**,|,androidx.**,|,com.**,|,junit.**,|,net.**,|,org.**,|,java.**,|,javax.**,|,*,|

[*.xml]
ij_xml_continuation_indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Generated by the Gradle wrapper task with CRLF line endings.
[*.{bat,cmd}]
end_of_line = crlf
